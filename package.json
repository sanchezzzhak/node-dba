{
  "name": "node-dba",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./src/index.js",
  "description": "Nodejs database ActiveRecord for (mySQL, Postgress, ClickHouse)",
  "scripts": {
    "test": "node --test --test-reporter=spec tests/*.spec.js",
    "build": "vite build"
  },
  "keywords": [
    "mysql",
    "postgress",
    "clickhouse",
    "active record",
    "migrations",
    "model"
  ],
  "author": "sanchezzzhak",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/sanchezzzhak/node-dba/issues"
  },
  "homepage": "https://github.com/sanchezzzhak/node-dba#readme",
  "engines": {
    "node": ">= 20.x",
    "npm": ">= 10.x"
  },
  "exports": {
    ".": {
      "import": "./src/index.js",
      "require": "./dist/index.cjs"
    },
    "./*": {
      "import": "./src/*.js",
      "require": "./dist/*.cjs"
    }
  },

  "devDependencies": {
    "vite": "^7.3.3",
    "glob": "^13.0.6"
  },
  "dependencies": {
    "eventemitter2": "^6.4.9",
    "pg": "^8.20.0",
    "undici": "^8.2.0"
  }
}
